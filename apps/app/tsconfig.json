{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // storybook.requires.ts is generated by the withStorybook metro wrapper
  // at bundle time (not hand-maintained, carries its own @ts-ignore
  // pragmas) — out of tsc's scope on purpose (spike S9).
  "exclude": ["node_modules", ".rnstorybook/storybook.requires.ts"]
}
