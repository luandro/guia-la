{
  "name": "guia-la",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.3 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "doctor": "pnpm --dir apps/app exec expo-doctor",
    "deps:check": "pnpm --dir apps/app exec expo install --check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "eslint-import-resolver-typescript": "^4.4.5",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
